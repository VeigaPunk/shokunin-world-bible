{
  "schema_version": 1,
  "scope": "one-to-one map completeness and source-ID binding for raw entity first_appearance values, entity claims, relations, and timeline records; no entailment, fidelity, chronology, rights, permission, or canon judgment",
  "raw_files": [
    "entities.json",
    "relations.json",
    "timeline.json"
  ],
  "map_grammar": {
    "section": "## JSON facts",
    "pointer": "one inline-code file.json#/pointer per row",
    "source_id_column": "In-world source ID or Source ID",
    "allowed_pointer_files": [
      "entities.json",
      "relations.json",
      "timeline.json"
    ]
  },
  "exit_codes": {
    "0": "PASS",
    "1": "FAIL",
    "2": "ERROR"
  },
  "self_test": {
    "cases": [
      {"id": "complete", "exit": 0, "finding_ids": []},
      {"id": "missing", "exit": 1, "finding_ids": ["missing_obligation"]},
      {"id": "duplicate", "exit": 1, "finding_ids": ["duplicate_mapping"]},
      {"id": "phantom", "exit": 1, "finding_ids": ["phantom_obligation"]},
      {"id": "source_id_mismatch", "exit": 1, "finding_ids": ["source_id_mismatch"]},
      {"id": "malformed_json", "exit": 2, "finding_ids": ["malformed_json"]},
      {"id": "co_mapped_grammar", "exit": 2, "finding_ids": ["unsupported_map"]},
      {"id": "legacy_grammar", "exit": 2, "finding_ids": ["unsupported_map"]},
      {"id": "invalid_pointer", "exit": 2, "finding_ids": ["invalid_pointer"]},
      {"id": "empty_segment", "exit": 2, "finding_ids": ["invalid_pointer"]},
      {"id": "noncanonical_index", "exit": 2, "finding_ids": ["invalid_pointer"]},
      {"id": "noncanonical_claim_index", "exit": 2, "finding_ids": ["invalid_pointer"]},
      {"id": "foreign_path", "exit": 2, "finding_ids": ["foreign_path"]},
      {"id": "traversal_path", "exit": 2, "finding_ids": ["unsafe_path"]},
      {"id": "symlink_path", "exit": 2, "finding_ids": ["unsafe_path"]},
      {"id": "frozen_complete", "exit": 0, "finding_ids": []},
      {"id": "frozen_tampered", "exit": 2, "finding_ids": ["snapshot_tampered"]},
      {"id": "frozen_missing_digests", "exit": 2, "finding_ids": ["unpinned"]},
      {"id": "frozen_expected_failure", "exit": 1, "finding_ids": ["missing_obligation"]},
      {"id": "frozen_verdict_mismatch", "exit": 2, "finding_ids": ["frozen_verdict_mismatch"]}
    ]
  }
}
