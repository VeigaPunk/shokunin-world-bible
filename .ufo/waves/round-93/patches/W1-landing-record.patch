+import argparse
+import json
+import sys
+from pathlib import Path
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--spec", type=Path)
+    parser.add_argument("--reports-dir", type=Path)
+    args = parser.parse_args()
+
+    base = Path(__file__).resolve().parent
+    spec_path = args.spec or base / "wave-spec.json"
+    reports_dir = args.reports_dir or base
+
+    try:
+        spec = json.loads(spec_path.read_text(encoding="utf-8"))
+        declared = spec["declared_seat_count"]
+        groups = spec["groups"]
+        seats = spec["seats"]
+        unidentified = spec["unidentified_declared_seat_slots"]
+        group_total = sum(group["declared_count"] for group in groups)
+        ids = [seat["id"] for seat in seats]
+        reports = sorted(path.name for path in reports_dir.glob("*.md") if path.name != "wave-spec.md")
+    except (OSError, json.JSONDecodeError, KeyError, TypeError) as exc:
+        print(f"FAIL input: {exc}", file=sys.stderr)
+        return 1
+
+    checks = [
+        ("group_total", group_total, declared),
+        ("enumerated_plus_unidentified", len(ids) + unidentified, declared),
+        ("unique_seat_ids", len(set(ids)), len(ids)),
+        ("delivered_reports", len(reports), declared),
+    ]
+    failed = False
+    for name, actual, expected in checks:
+        status = "PASS" if actual == expected else "FAIL"
+        print(f"{status} {name}: observed={actual} expected={expected}")
+        failed |= actual != expected
+    if failed:
+        print("report_files=" + ",".join(reports))
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
