#!/bin/bash
# V28 round-98 final battery — documented commands replayed exactly as written.
set -u
cd /home/vgpnk/Projects/shokunin/lore-shokunin
S=.ufo/waves/round-98/seats/V28-scratch

echo "== $(date -u +%H:%M:%S) hashes before =="
sha256sum corpus/tools/README.md corpus/tools/dependency_freeze.py corpus/tools/dependency-freeze-contract.json corpus/tools/map_obligations.py corpus/tools/map-obligations-contract.json corpus/tools/support_check.py corpus/fixtures/check_bible.py corpus/fixtures/r95-crossing-aftermath/claim-excerpt-map.md corpus/knowledge/r98-clerk-scope-note.md corpus/knowledge/r95-aftermath-scope-note.md corpus/knowledge/r96-response-scope-note.md
sha256sum corpus/fixtures/r98-clerk-filing/*.json corpus/fixtures/r98-clerk-filing/*.md

echo "== A: r98 README replay block (r98 README:25-29) =="
python3 corpus/fixtures/check_bible.py corpus/fixtures/r98-clerk-filing; echo "A1-EXIT=$?"
python3 corpus/tools/support_check.py corpus/fixtures/r98-clerk-filing; echo "A2-EXIT=$?"
python3 corpus/tools/map_obligations.py corpus/fixtures/r98-clerk-filing; echo "A3-EXIT=$?"

echo "== B: r97 retained replay block (r97 README:25-29) =="
python3 corpus/fixtures/check_bible.py corpus/fixtures/r97-crossing-acknowledgment; echo "B1-EXIT=$?"
python3 corpus/tools/support_check.py corpus/fixtures/r97-crossing-acknowledgment; echo "B2-EXIT=$?"
python3 corpus/tools/map_obligations.py corpus/fixtures/r97-crossing-acknowledgment; echo "B3-EXIT=$?"

echo "== C: r95/r96 addendum receipts (S5 addenda) =="
python3 corpus/fixtures/check_bible.py corpus/fixtures/r95-crossing-aftermath; echo "C1-EXIT=$?"
python3 corpus/tools/support_check.py corpus/fixtures/r95-crossing-aftermath; echo "C2-EXIT=$?"
python3 corpus/tools/map_obligations.py corpus/fixtures/r95-crossing-aftermath; echo "C3-EXIT=$?"
python3 corpus/fixtures/check_bible.py corpus/fixtures/r96-crossing-response; echo "C4-EXIT=$?"
python3 corpus/tools/support_check.py corpus/fixtures/r96-crossing-response; echo "C5-EXIT=$?"
python3 corpus/tools/map_obligations.py corpus/fixtures/r96-crossing-response; echo "C6-EXIT=$?"

echo "== D: S2 addendum self-test + map_obligations unchanged =="
python3 corpus/tools/dependency_freeze.py --self-test | tail -2
python3 corpus/tools/map_obligations.py --self-test | tail -2

echo "== E: census =="
ls -d corpus/fixtures/*/ | wc -l

echo "== F: residue =="
ls -d *-self-test-* 2>/dev/null || echo "no self-test scratch at root"
