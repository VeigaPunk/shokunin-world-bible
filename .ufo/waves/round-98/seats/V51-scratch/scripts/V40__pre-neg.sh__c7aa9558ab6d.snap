#!/bin/bash
# V40 pre-state negatives against the 9a3d648 baseline tool (mirror at $1)
# Usage: pre-neg.sh <mirror-root>
set -u
M="$1"
TOOL="$M/corpus/tools/dependency_freeze.py"
CT="$M/corpus/tools/dependency-freeze-contract.json"
FIX="$M/corpus/fixtures/r95-crossing-aftermath"

echo "### pre-a: SELF-TEST-MISMATCH exit (expect mismatch in self_test.expected.clean.exit)"
python3 - "$CT" <<'PY'
import json,sys
p=sys.argv[1]; c=json.load(open(p))
c["self_test"]["expected"]["clean"]["exit"]=1
json.dump(c,open(p,"w"),indent=2,ensure_ascii=False)
PY
python3 "$TOOL" --self-test; echo "EXIT=$?"
git -C "$M" checkout -- . 2>/dev/null || true

echo
echo "### pre-b: path-less legacy pin migrated by --freeze?"
python3 - "$CT" <<'PY'
import json,sys
p=sys.argv[1]; c=json.load(open(p))
pin=c["pins"]["r95-crossing-aftermath"]
pin.pop("fixture",None)
json.dump(c,open(p,"w"),indent=2,ensure_ascii=False)
PY
python3 "$TOOL" --freeze "$FIX"; echo "EXIT=$?"

echo
echo "### pre-b2: path-less legacy pin under verify"
python3 "$TOOL" "$FIX"; echo "EXIT=$?"

echo
echo "### pre-c: precedence text"
python3 -c "import json;print(json.load(open('$CT'))['precedence'])"
