+def parse_inventory(lines):
+    headings = [index for index, line in enumerate(lines) if INVENTORY_HEADING.fullmatch(line.strip())]
+    if len(headings) != 1:
+        return None, "map must contain exactly one ## Inventory section"
+    start = headings[0] + 1
+    end = next(
+        (index for index in range(start, len(lines)) if re.match(r"^#{1,6}\s", lines[index])),
+        len(lines),
+    )
+    declarations = []
+    for line in lines[start:end]:
+        match = INVENTORY_COUNTS.fullmatch(line)
+        if match:
+            declarations.append(match)
+    if len(declarations) != 1:
+        return None, "Inventory must declare json_rows=N, editorial_rows=M exactly once"
+    return (int(declarations[0].group(1)), int(declarations[0].group(2))), ""
+
