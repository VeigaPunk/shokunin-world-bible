{
  "schema_version": 1,
  "scope": "one-to-one map completeness and source-ID binding for raw entity first_appearance values, entity claims, relations, and timeline records; no entailment, fidelity, chronology, rights, permission, or canon judgment",
  "raw_files": [
    "entities.json",
    "relations.json",
    "timeline.json"
  ],
  "map_grammar": {
    "section": "## JSON facts",
    "pointer": "one inline-code file.json#/pointer per row",
    "source_id_column": "In-world source ID or Source ID",
    "allowed_pointer_files": [
      "entities.json",
      "relations.json",
      "timeline.json"
    ]
  },
  "legacy_pointer_dialect": {
    "enabled_by": "pointer column whose normalized header is 'JSON fact and fields' (the r88 map form)",
    "pointer": "one inline-code field-path token per row: entities[i].first_appearance, entities[i].claims[j], relations[i], or timeline[i]; translated to the canonical pointer before comparison",
    "fallback": "canonical file.json#/pointer cells remain accepted in a legacy-header table; field-path tokens are not accepted under a canonical header"
  },
  "exit_codes": {
    "0": "PASS",
    "1": "FAIL",
    "2": "ERROR"
  },
  "self_test": {
    "cases": [
      {
        "id": "complete",
        "exit": 0,
        "finding_ids": []
      },
      {
        "id": "missing",
        "exit": 1,
        "finding_ids": [
          "missing_obligation"
        ]
      },
      {
