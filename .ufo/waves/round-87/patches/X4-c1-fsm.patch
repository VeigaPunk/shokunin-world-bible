+class ProvenanceAssessment:
+    def __init__(self, eligible):
+        self._state = ('assessing',) if eligible else (
+            'stopped', 'chain eligibility preconditions unavailable', None
+        )
+
+    @property
+    def assessing(self):
+        return self._state[0] == 'assessing'
+
+    @property
+    def stop_cause(self):
+        return self._state[1] if not self.assessing else None
+
+    @property
+    def stop_location(self):
+        return self._state[2] if not self.assessing else None
+
+    def stop(self, cause, location):
+        if self.assessing:
+            self._state = ('stopped', cause, location)
+
